generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model roles {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @unique(map: "uk_roles_name") @db.VarChar(100)
  description String?   @db.VarChar(255)
  is_default  Boolean   @default(false)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.Timestamp(0)
  deleted_at  DateTime? @db.Timestamp(0)
  users       users[]

  @@map("roles")
}

model users {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  role_id              BigInt                 @db.UnsignedBigInt
  name                 String                 @db.VarChar(255)
  email                String                 @unique(map: "uk_users_email") @db.VarChar(255)
  password_hash        String                 @db.VarChar(255)
  phone                String?                @db.VarChar(30)
  status               users_status           @default(active)
  last_login_at        DateTime?              @db.Timestamp(0)
  created_at           DateTime?              @default(now()) @db.Timestamp(0)
  updated_at           DateTime?              @default(now()) @db.Timestamp(0)
  deleted_at           DateTime?              @db.Timestamp(0)
  audit_logs           audit_logs[]
  customers            customers[]
  notifications        notifications[]
  order_status_history order_status_history[]
  orders_cancelled_by  orders[]               @relation("orders_cancelled_by")
  orders_sales         orders[]               @relation("orders_sales")
  team_members         team_members[]
  user_jobs            user_jobs[]
  roles                roles                  @relation(fields: [role_id], references: [id], map: "fk_users_role")

  @@index([role_id], map: "idx_users_role_id")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

model password_resets {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  email      String    @db.VarChar(255)
  token      String    @unique(map: "uk_password_resets_token") @db.VarChar(255)
  expires_at DateTime  @default(now()) @db.Timestamp(0)
  created_at DateTime? @default(now()) @db.Timestamp(0)

  @@index([email], map: "idx_password_resets_email")
  @@map("password_resets")
}

model jobs {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  name              String              @unique(map: "uk_jobs_name") @db.VarChar(100)
  description       String?             @db.VarChar(255)
  status            jobs_status         @default(active)
  created_at        DateTime?           @default(now()) @db.Timestamp(0)
  updated_at        DateTime?           @default(now()) @db.Timestamp(0)
  deleted_at        DateTime?           @db.Timestamp(0)
  order_assignments order_assignments[]
  user_jobs         user_jobs[]

  @@index([status], map: "idx_jobs_status")
  @@map("jobs")
}

model user_jobs {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  job_id     BigInt    @db.UnsignedBigInt
  is_primary Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  jobs       jobs      @relation(fields: [job_id], references: [id], onDelete: Cascade, map: "fk_uj_job")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_uj_user")

  @@unique([user_id, job_id], map: "uk_user_job")
  @@index([user_id], map: "idx_uj_user_id")
  @@index([job_id], map: "idx_uj_job_id")
  @@index([user_id, is_primary], map: "idx_uj_primary")
  @@map("user_jobs")
}

model service_categories {
  id          BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String                    @unique(map: "uk_service_categories_name") @db.VarChar(255)
  description String?                   @db.Text
  status      service_categories_status @default(active)
  created_at  DateTime?                 @default(now()) @db.Timestamp(0)
  updated_at  DateTime?                 @default(now()) @db.Timestamp(0)
  deleted_at  DateTime?                 @db.Timestamp(0)
  services    services[]

  @@map("service_categories")
}

model services {
  id                 BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  category_id        BigInt             @db.UnsignedBigInt
  name               String             @db.VarChar(255)
  description        String?            @db.Text
  default_price      Decimal            @default(0.00) @db.Decimal(15, 2)
  duration           Int                @default(0)
  status             services_status    @default(active)
  created_at         DateTime?          @default(now()) @db.Timestamp(0)
  updated_at         DateTime?          @default(now()) @db.Timestamp(0)
  deleted_at         DateTime?          @db.Timestamp(0)
  order_services     order_services[]
  service_categories service_categories @relation(fields: [category_id], references: [id], map: "fk_services_category")

  @@index([category_id], map: "idx_services_category_id")
  @@index([status], map: "idx_services_status")
  @@map("services")
}

model customers {
  id            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  sales_id      BigInt?         @db.UnsignedBigInt
  name          String          @db.VarChar(255)
  email         String          @unique(map: "uk_customers_email") @db.VarChar(255)
  phone         String?         @db.VarChar(30)
  address       String?         @db.Text
  notes         String?         @db.Text
  created_at    DateTime?       @default(now()) @db.Timestamp(0)
  updated_at    DateTime?       @default(now()) @db.Timestamp(0)
  deleted_at    DateTime?       @db.Timestamp(0)
  customer_pics customer_pics[]
  sales_user    users?          @relation(fields: [sales_id], references: [id], map: "fk_customers_sales")
  invoices      invoices[]
  orders        orders[]

  @@index([sales_id], map: "idx_customers_sales_id")
  @@map("customers")
}

model customer_pics {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id BigInt    @db.UnsignedBigInt
  name        String    @db.VarChar(255)
  position    String?   @db.VarChar(100)
  email       String?   @db.VarChar(255)
  phone       String?   @db.VarChar(30)
  is_primary  Boolean   @default(false)
  is_active   Boolean   @default(true)
  valid_from  DateTime? @db.Date
  valid_to    DateTime? @db.Date
  notes       String?   @db.Text
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.Timestamp(0)
  deleted_at  DateTime? @db.Timestamp(0)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, map: "fk_cp_customer")
  orders      orders[]

  @@index([customer_id], map: "idx_cp_customer_id")
  @@index([customer_id, is_active, is_primary], map: "idx_cp_active_primary")
  @@index([email], map: "idx_cp_email")
  @@map("customer_pics")
}

model teams {
  id           BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  name         String         @unique(map: "uk_teams_name") @db.VarChar(100)
  description  String?        @db.Text
  status       teams_status   @default(active)
  created_at   DateTime?      @default(now()) @db.Timestamp(0)
  updated_at   DateTime?      @default(now()) @db.Timestamp(0)
  deleted_at   DateTime?      @db.Timestamp(0)
  orders       orders[]
  team_members team_members[]

  @@index([status], map: "idx_teams_status")
  @@map("teams")
}

model team_members {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  team_id           BigInt              @db.UnsignedBigInt
  user_id           BigInt              @db.UnsignedBigInt
  joined_at         DateTime?           @default(now()) @db.Timestamp(0)
  status            team_members_status @default(active)
  order_assignments order_assignments[]
  teams             teams               @relation(fields: [team_id], references: [id], onDelete: Cascade, map: "fk_tm_team")
  users             users               @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_tm_user")

  @@unique([team_id, user_id], map: "uk_team_user")
  @@index([team_id], map: "idx_tm_team_id")
  @@index([user_id], map: "idx_tm_user_id")
  @@index([status], map: "idx_tm_status")
  @@map("team_members")
}

model orders {
  id                        BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  order_number              String                 @unique(map: "uk_orders_order_number") @db.VarChar(100)
  parent_order_id           BigInt?                @db.UnsignedBigInt
  customer_id               BigInt                 @db.UnsignedBigInt
  pic_id                    BigInt?                @db.UnsignedBigInt
  sales_id                  BigInt?                @db.UnsignedBigInt
  team_id                   BigInt?                @db.UnsignedBigInt
  customer_name_snapshot    String?                @db.VarChar(255)
  customer_address_snapshot String?                @db.Text
  pic_name_snapshot         String?                @db.VarChar(255)
  pic_email_snapshot        String?                @db.VarChar(255)
  status                    orders_status          @default(pending)
  payment_status            orders_payment_status  @default(unpaid)
  subtotal                  Decimal                @default(0.00) @db.Decimal(15, 2)
  discount_type             orders_discount_type   @default(fixed)
  discount                  Decimal                @default(0.00) @db.Decimal(15, 2)
  tax_rate                  Decimal                @default(0.00) @db.Decimal(5, 2)
  tax                       Decimal                @default(0.00) @db.Decimal(15, 2)
  grand_total               Decimal                @default(0.00) @db.Decimal(15, 2)
  start_date_project        DateTime?              @db.DateTime(0)
  end_date_project          DateTime?              @db.DateTime(0)
  notes                     String?                @db.Text
  cancelled_reason          String?                @db.Text
  cancelled_at              DateTime?              @db.Timestamp(0)
  cancelled_by              BigInt?                @db.UnsignedBigInt
  created_at                DateTime?              @default(now()) @db.Timestamp(0)
  updated_at                DateTime?              @default(now()) @db.Timestamp(0)
  deleted_at                DateTime?              @db.Timestamp(0)
  email_logs                email_logs[]
  invoices                  invoices[]
  maintenances              maintenances[]
  order_assignments         order_assignments[]
  order_services            order_services[]
  order_status_history      order_status_history[]
  cancelled_by_user         users?                 @relation("orders_cancelled_by", fields: [cancelled_by], references: [id], map: "fk_orders_cancelled_by")
  customers                 customers              @relation(fields: [customer_id], references: [id], map: "fk_orders_customer")
  parent_order              orders?                @relation("OrderParent", fields: [parent_order_id], references: [id], map: "fk_orders_parent")
  child_orders              orders[]               @relation("OrderParent")
  customer_pics             customer_pics?         @relation(fields: [pic_id], references: [id], map: "fk_orders_pic")
  sales_user                users?                 @relation("orders_sales", fields: [sales_id], references: [id], map: "fk_orders_sales")
  teams                     teams?                 @relation(fields: [team_id], references: [id], map: "fk_orders_team")

  @@index([customer_id], map: "idx_orders_customer_id")
  @@index([pic_id], map: "idx_orders_pic_id")
  @@index([sales_id], map: "idx_orders_sales_id")
  @@index([team_id], map: "idx_orders_team_id")
  @@index([parent_order_id], map: "idx_orders_parent_id")
  @@index([status, payment_status], map: "idx_orders_status_payment")
  @@index([start_date_project, end_date_project], map: "idx_orders_dates")
  @@index([cancelled_by], map: "idx_orders_cancelled_by")
  @@map("orders")
}

model order_services {
  id                     BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  order_id               BigInt                @db.UnsignedBigInt
  service_id             BigInt?               @db.UnsignedBigInt
  service_name_snapshot  String                @db.VarChar(255)
  category_name_snapshot String?               @db.VarChar(255)
  is_custom              Boolean               @default(false)
  price_deal             Decimal               @default(0.00) @db.Decimal(15, 2)
  quantity               Int                   @default(1)
  subtotal               Decimal               @default(0.00) @db.Decimal(15, 2)
  status                 order_services_status @default(active)
  cancelled_reason       String?               @db.Text
  cancelled_at           DateTime?             @db.Timestamp(0)
  notes                  String?               @db.Text
  created_at             DateTime?             @default(now()) @db.Timestamp(0)
  updated_at             DateTime?             @default(now()) @db.Timestamp(0)
  deleted_at             DateTime?             @db.Timestamp(0)
  orders                 orders                @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_os_order")
  services               services?             @relation(fields: [service_id], references: [id], onDelete: Restrict, map: "fk_os_service")

  @@index([order_id], map: "idx_os_order_id")
  @@index([service_id], map: "idx_os_service_id")
  @@index([status], map: "idx_os_status")
  @@index([is_custom], map: "idx_os_is_custom")
  @@map("order_services")
}

model order_assignments {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  order_id       BigInt           @db.UnsignedBigInt
  team_member_id BigInt           @db.UnsignedBigInt
  job_id         BigInt           @db.UnsignedBigInt
  is_lead        Boolean          @default(false)
  assigned_at    DateTime?        @default(now()) @db.Timestamp(0)
  jobs           jobs             @relation(fields: [job_id], references: [id], map: "fk_oa_job")
  orders         orders           @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_oa_order")
  team_members   team_members     @relation(fields: [team_member_id], references: [id], onDelete: Cascade, map: "fk_oa_team_member")
  progress_order progress_order[]

  @@unique([order_id, team_member_id], map: "uk_order_team_member")
  @@index([order_id], map: "idx_oa_order_id")
  @@index([team_member_id], map: "idx_oa_team_member_id")
  @@index([job_id], map: "idx_oa_job_id")
  @@index([team_member_id, is_lead], map: "idx_oa_lead")
  @@map("order_assignments")
}

model order_status_history {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  order_id    BigInt    @db.UnsignedBigInt
  from_status String?   @db.VarChar(50)
  to_status   String    @db.VarChar(50)
  changed_by  BigInt?   @db.UnsignedBigInt
  notes       String?   @db.Text
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  orders      orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_osh_order")
  users       users?    @relation(fields: [changed_by], references: [id], map: "fk_osh_user")

  @@index([order_id], map: "idx_osh_order_id")
  @@index([created_at], map: "idx_osh_created")
  @@index([changed_by], map: "idx_osh_changed_by")
  @@index([order_id, created_at], map: "idx_osh_order_created")
  @@map("order_status_history")
}

model invoices {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  invoice_number      String                @unique(map: "uk_invoices_invoice_number") @db.VarChar(100)
  order_id            BigInt                @db.UnsignedBigInt
  customer_id         BigInt                @db.UnsignedBigInt
  total_paid          Decimal               @default(0.00) @db.Decimal(15, 2)
  status              invoices_status       @default(unpaid)
  due_date            DateTime?             @db.Date
  issued_at           DateTime?             @db.Timestamp(0)
  paid_at             DateTime?             @db.Timestamp(0)
  created_at          DateTime?             @default(now()) @db.Timestamp(0)
  updated_at          DateTime?             @default(now()) @db.Timestamp(0)
  deleted_at          DateTime?             @db.Timestamp(0)
  email_logs          email_logs[]
  invoice_attachments invoice_attachments[]
  customers           customers             @relation(fields: [customer_id], references: [id], map: "fk_invoices_customer")
  orders              orders                @relation(fields: [order_id], references: [id], map: "fk_invoices_order")

  @@index([order_id], map: "idx_invoices_order_id")
  @@index([customer_id], map: "idx_invoices_customer_id")
  @@index([status, due_date], map: "idx_invoices_status_due")
  @@map("invoices")
}

model progress_order {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  assignment_id        BigInt                 @db.UnsignedBigInt
  title                String                 @db.VarChar(255)
  description          String?                @db.Text
  status               progress_order_status  @default(pending)
  progress_percentage  Int                    @default(0)
  notes                String?                @db.Text
  started_at           DateTime?              @db.Timestamp(0)
  completed_at         DateTime?              @db.Timestamp(0)
  created_at           DateTime?              @default(now()) @db.Timestamp(0)
  updated_at           DateTime?              @default(now()) @db.Timestamp(0)
  deleted_at           DateTime?              @db.Timestamp(0)
  progress_attachments progress_attachments[]
  order_assignments    order_assignments      @relation(fields: [assignment_id], references: [id], onDelete: Cascade, map: "fk_progress_assignment")

  @@index([assignment_id], map: "idx_progress_assignment_id")
  @@index([status], map: "idx_progress_status")
  @@map("progress_order")
}

model progress_attachments {
  id             BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  progress_id    BigInt         @db.UnsignedBigInt
  file_path      String         @db.VarChar(500)
  file_name      String         @db.VarChar(255)
  file_type      String?        @db.VarChar(50)
  file_size      BigInt?        @db.UnsignedBigInt
  uploaded_at    DateTime?      @default(now()) @db.Timestamp(0)
  progress_order progress_order @relation(fields: [progress_id], references: [id], onDelete: Cascade, map: "fk_pa_progress")

  @@index([progress_id], map: "idx_pa_progress_id")
  @@index([uploaded_at], map: "idx_pa_uploaded")
  @@map("progress_attachments")
}

model maintenances {
  id             BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  order_id       BigInt              @db.UnsignedBigInt
  title          String              @db.VarChar(255)
  description    String?             @db.Text
  status         maintenances_status @default(scheduled)
  start_datetime DateTime?           @db.DateTime(0)
  end_datetime   DateTime?           @db.DateTime(0)
  notes          String?             @db.Text
  created_at     DateTime?           @default(now()) @db.Timestamp(0)
  updated_at     DateTime?           @default(now()) @db.Timestamp(0)
  deleted_at     DateTime?           @db.Timestamp(0)
  orders         orders              @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_maintenances_order")

  @@index([order_id], map: "idx_maintenances_order_id")
  @@index([status], map: "idx_maintenances_status")
  @@map("maintenances")
}

model notifications {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  type       String?   @db.VarChar(100)
  title      String    @db.VarChar(255)
  message    String?   @db.Text
  data       String?   @db.LongText
  is_read    Boolean   @default(false)
  read_at    DateTime? @db.Timestamp(0)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_notifications_user")

  @@index([user_id], map: "idx_notifications_user_id")
  @@index([is_read], map: "idx_notifications_is_read")
  @@index([user_id, is_read], map: "idx_notifications_user_read")
  @@map("notifications")
}

model email_logs {
  id                  BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  recipient           String            @db.VarChar(255)
  subject             String?           @db.VarChar(255)
  body                String?           @db.LongText
  status              email_logs_status @default(pending)
  retry_count         Int               @default(0)
  related_order_id    BigInt?           @db.UnsignedBigInt
  related_invoice_id  BigInt?           @db.UnsignedBigInt
  error_message       String?           @db.Text
  provider_message_id String?           @db.VarChar(255)
  sent_at             DateTime?         @db.Timestamp(0)
  created_at          DateTime?         @default(now()) @db.Timestamp(0)
  updated_at          DateTime?         @default(now()) @db.Timestamp(0)
  invoices            invoices?         @relation(fields: [related_invoice_id], references: [id], map: "fk_email_logs_invoice")
  orders              orders?           @relation(fields: [related_order_id], references: [id], map: "fk_email_logs_order")

  @@index([related_order_id], map: "idx_email_logs_related_order_id")
  @@index([related_invoice_id], map: "idx_email_logs_related_invoice_id")
  @@index([status], map: "idx_email_logs_status")
  @@map("email_logs")
}

model audit_logs {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     BigInt?   @db.UnsignedBigInt
  action      String    @db.VarChar(100)
  entity_type String?   @db.VarChar(100)
  entity_id   BigInt?   @db.UnsignedBigInt
  before_data String?   @db.LongText
  after_data  String?   @db.LongText
  ip_address  String?   @db.VarChar(45)
  user_agent  String?   @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  users       users?    @relation(fields: [user_id], references: [id], map: "fk_audit_logs_user")

  @@index([user_id], map: "idx_audit_logs_user_id")
  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
  @@index([created_at], map: "idx_audit_logs_created")
  @@map("audit_logs")
}

model invoice_attachments {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  invoice_id  BigInt    @db.UnsignedBigInt
  file_path   String    @db.VarChar(500)
  file_name   String    @db.VarChar(255)
  file_type   String?   @db.VarChar(50)
  file_size   BigInt?   @db.UnsignedBigInt
  uploaded_at DateTime? @default(now()) @db.Timestamp(0)
  invoices    invoices  @relation(fields: [invoice_id], references: [id], onDelete: Cascade, map: "fk_ia_invoice")

  @@index([invoice_id], map: "idx_ia_invoice_id")
  @@index([uploaded_at], map: "idx_ia_uploaded")
}

enum users_status {
  active
  inactive
  suspended
  pending
}

enum service_categories_status {
  active
  inactive
}

enum services_status {
  active
  inactive
}

enum teams_status {
  active
  inactive
}

enum team_members_status {
  active
  inactive
}

enum jobs_status {
  active
  inactive
}

enum orders_status {
  draft
  pending
  in_progress
  completed
  cancelled
}

enum orders_payment_status {
  unpaid
  partial
  paid
  refunded
  failed
}

enum orders_discount_type {
  percent
  fixed
}

enum order_services_status {
  active
  cancelled
  refunded
}

enum invoices_status {
  unpaid
  partial
  paid
  overdue
  cancelled
}

enum progress_order_status {
  pending
  in_progress
  completed
  cancelled
}

enum maintenances_status {
  scheduled
  in_progress
  completed
  cancelled
}

enum email_logs_status {
  pending
  sent
  failed
  retrying
}
